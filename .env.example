# Copy this file to .env and set your local PostgreSQL connection details.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_portal
DB_USER=postgres
DB_PASSWORD=change-this-password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: set DATABASE_URL to override the DB_* settings.
