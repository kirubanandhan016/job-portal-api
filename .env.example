# Copy this file to .env and set your local PostgreSQL connection details.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_portal
DB_USER=postgres
DB_PASSWORD=change-this-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: set DATABASE_URL to override the DB_* settings.
